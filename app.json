        "title": {
          "en": "The app was deleted",
          "nl": "De app is verwijderd"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=app"
          }
        ],
        "id": "app_deleted"
      },
      {
