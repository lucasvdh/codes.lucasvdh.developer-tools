      {
        "title": {
          "en": "A new build was created",
          "nl": "Er is een nieuwe build aangemaakt"
        },
        "tokens": [
          {
            "name": "version",
            "type": "string",
            "title": {
              "en": "App version",
              "nl": "App versie"
            },
            "example": "1.5.2"
          },
          {
            "name": "build_id",
            "type": "number",
            "title": {
              "en": "Build ID",
              "nl": "Build-ID"
            },
            "example": "5"
          },
          {
            "name": "state",
            "type": "string",
            "title": {
              "en": "Build state",
              "nl": "Build status"
            },
            "example": "test"
          }
        ],
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=app"
          }
        ],
        "id": "app_build_created"
      },
      {
