  "api": {
    "testToken": {
      "method": "post",
      "path": "/test-token",
      "public": false
    },
    "listTokens": {
      "method": "get",
      "path": "/tokens",
      "public": false
    },
    "addToken": {
      "method": "post",
      "path": "/tokens",
      "public": false
    },
    "removeToken": {
      "method": "delete",
      "path": "/tokens/:id",
      "public": false
    },
    "testTokenById": {
      "method": "post",
      "path": "/tokens/:id/test",
