  "drivers": [
    {
      "name": {
        "en": "Homey App"
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "pair": [
        {
          "id": "loading",
          "template": "loading"
        },
        {
          "id": "not_configured"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "images": {
        "large": "./drivers/app/assets/images/large.png",
        "small": "./drivers/app/assets/images/small.png"
      },
      "class": "other",
      "capabilities": [
        "installs",
        "installs_cloud",
        "installs_local",
        "rating",
        "live_version",
